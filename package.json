{
  "name": "lain-ikawura-bot",
  "version": "2.0.0",
  "description": "Bot de Discord de música (YouTube/Spotify) con estética Lain — reescrito en TypeScript",
  "private": true,
  "main": "dist/index.js",
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "deploy": "tsx src/deploy-commands.ts",
    "deploy:prod": "node dist/deploy-commands.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@discordjs/voice": "^0.19.2",
    "@spotify/web-api-ts-sdk": "^1.2.0",
    "discord.js": "^14.27.0",
    "dotenv": "^18.0.8",
    "libsodium-wrappers": "^0.8.4",
    "opusscript": "^0.0.8",
    "prism-media": "^1.3.5"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.6.0"
  }
}
